{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:compute:reason-adjudication:1",
  "title": "PSDC Lease Reason Adjudication",
  "description": "Signed lease-authority decision about an asserted termination reason. A provider or meter receipt cannot make this decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "adjudicationId", "leaseId", "receiptId", "providerId", "assertedReasonCode", "status", "adjudicatorId", "authorityInstitutionId", "policyDecision", "decidedAt", "evidence", "signature"],
  "properties": {
    "contractVersion": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/contractVersion" },
    "adjudicationId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "leaseId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "receiptId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "receiptDigest": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/sha256" },
    "providerId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "assertedReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "status": { "enum": ["confirmed", "disputed", "unattributed"] },
    "determinedReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "adjudicatorId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "authorityInstitutionId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/institutionId" },
    "policyDecision": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/policyDecisionRef" },
    "decidedAt": { "type": "string", "format": "date-time" },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/evidenceRef" } },
    "effects": {
      "type": "object", "additionalProperties": false, "required": ["retryable", "providerFault", "settlementDisposition"],
      "properties": {
        "retryable": { "type": "boolean" },
        "providerFault": { "type": "boolean" },
        "settlementDisposition": { "enum": ["ordinary", "refund_review", "penalty_review"] }
      }
    },
    "signature": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/signature" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "confirmed" } }, "required": ["status"] }, "then": { "required": ["receiptDigest", "determinedReasonCode", "effects"] }, "else": { "not": { "anyOf": [{ "required": ["determinedReasonCode"] }, { "required": ["effects"] }] } } }
  ]
}
