{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:compute:usage-receipt:1",
  "title": "PSDC Usage Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "receiptId", "leaseId", "workloadId", "providerId", "meterId", "sequence", "attempt", "interval", "status", "measurements", "outcome", "evidence", "recordedAt", "signature"],
  "properties": {
    "contractVersion": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/contractVersion" },
    "receiptId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "leaseId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "workloadId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "providerId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "meterId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "sequence": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 100 },
    "interval": {
      "type": "object", "additionalProperties": false, "required": ["startedAt", "endedAt"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" }
      }
    },
    "status": { "enum": ["measured", "failed", "disputed", "voided"] },
    "measurements": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/measurement" } },
    "outcome": { "enum": ["succeeded", "failed", "cancelled", "preempted", "lost"] },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/evidenceRef" } },
    "priorReceiptDigest": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/sha256" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "reason": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/reason" },
    "signature": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/signature" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "enum": ["failed", "disputed", "voided"] } }, "required": ["status"] }, "then": { "required": ["reason"] } },
    { "if": { "properties": { "sequence": { "type": "integer", "minimum": 2 } }, "required": ["sequence"] }, "then": { "required": ["priorReceiptDigest"] } },
    { "if": { "properties": { "sequence": { "type": "integer", "const": 1 } }, "required": ["sequence"] }, "then": { "not": { "required": ["priorReceiptDigest"] } } }
  ]
}
