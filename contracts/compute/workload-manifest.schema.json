{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:compute:workload-manifest:1",
  "title": "PSDC Workload Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "workloadId", "requestId", "idempotencyKey", "requester", "accountableOwnerId", "submittedAt", "purpose", "dataClassification", "workloadClass", "criticality", "backendPreferences", "resources", "runtime", "parallelism", "placement", "networkRequirements", "storageRequirements", "schedule", "retryPolicy", "budgetCeiling", "softwareLicenseDecision", "policyDecision", "signature"],
  "properties": {
    "contractVersion": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/contractVersion" },
    "workloadId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "requestId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$" },
    "requester": {
      "type": "object", "additionalProperties": false, "required": ["subjectId", "institutionId", "projectId"],
      "properties": {
        "subjectId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
        "institutionId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/institutionId" },
        "projectId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" }
      }
    },
    "submittedAt": { "type": "string", "format": "date-time" },
    "purpose": { "type": "string", "minLength": 3, "maxLength": 500 },
    "accountableOwnerId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "dataClassification": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/dataClassification" },
    "workloadClass": { "enum": ["opportunistic_task", "independent_task_graph", "parameter_sweep", "container_service", "vm", "hpc_mpi", "ai_inference", "ai_service", "critical_service"] },
    "criticality": { "enum": ["experimental", "standard", "important", "critical", "safety_records_authority"] },
    "backendPreferences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/backendKind" } },
    "resources": { "type": "object", "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/resourceQuantity", "required": ["cpuMillis", "memoryBytes", "gpuCount", "ephemeralStorageBytes", "nodeCount"] },
    "parallelism": {
      "type": "object", "additionalProperties": false, "required": ["maximumConcurrentTasks", "interTaskCommunication"],
      "properties": {
        "maximumConcurrentTasks": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "interTaskCommunication": { "enum": ["none", "loosely_coupled", "tightly_coupled"] },
        "checkpointCapable": { "type": "boolean" }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["imageRef", "imageDigest"],
      "properties": {
        "imageRef": { "type": "string", "pattern": "^(oci|vm)://", "maxLength": 1024 },
        "imageDigest": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/sha256" },
        "command": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 4096 } },
        "environmentRefs": { "type": "array", "maxItems": 64, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/resourceRef" } },
        "workingDirectory": { "type": "string", "pattern": "^/", "maxLength": 1024 }
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "inputs": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/resourceRef" } },
        "outputs": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/resourceRef" } }
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false, "required": ["institutionScope", "allowFederation", "minimumTrustTier", "residencyCountries"],
      "properties": {
        "institutionScope": { "enum": ["local_only", "approved_federation", "approved_external"] },
        "allowFederation": { "type": "boolean" },
        "minimumTrustTier": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/trustTier" },
        "allowedProviderIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" } },
        "allowedZoneIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" } },
        "residencyCountries": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } }
      }
    },
    "networkRequirements": {
      "type": "object", "additionalProperties": false, "required": ["ingressMode", "egressMode", "reservationRequired"],
      "properties": {
        "ingressMode": { "enum": ["none", "institution_only", "public_approved"] },
        "egressMode": { "enum": ["none", "allowlisted", "unrestricted_approved"] },
        "minimumBandwidthMbps": { "type": "integer", "minimum": 1 },
        "maximumLatencyMs": { "type": "integer", "minimum": 1 },
        "networkProfileId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
        "reservationRequired": { "type": "boolean" }
      }
    },
    "storageRequirements": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["objectId", "access", "requiredTier"],
        "properties": {
          "objectId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
          "access": { "enum": ["read", "write", "read_write"] },
          "requiredTier": { "type": "integer", "minimum": 0, "maximum": 5 }
        }
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false, "required": ["priority", "preemptible", "maxRuntimeSeconds"],
      "properties": {
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "preemptible": { "type": "boolean" },
        "deadline": { "type": "string", "format": "date-time" },
        "maxRuntimeSeconds": { "type": "integer", "minimum": 1, "maximum": 2592000 },
        "checkpointIntervalSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 }
      }
    },
    "serviceObjectives": {
      "type": "object", "additionalProperties": false, "required": ["availabilityTargetPercent", "rpoSeconds", "rtoSeconds", "maximumLatencyMs"],
      "properties": {
        "availabilityTargetPercent": { "type": "string", "pattern": "^(?:100(?:\\.0{1,3})?|(?:[0-9]|[1-9][0-9])(?:\\.[0-9]{1,3})?)$" },
        "rpoSeconds": { "type": "integer", "minimum": 0 },
        "rtoSeconds": { "type": "integer", "minimum": 0 },
        "maximumLatencyMs": { "type": "integer", "minimum": 1 }
      }
    },
    "budgetCeiling": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/nonNegativeCreditAmount" },
    "softwareLicenseDecision": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/policyDecisionRef" },
    "retryPolicy": {
      "type": "object", "additionalProperties": false, "required": ["maxAttempts", "backoff", "initialDelaySeconds"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "backoff": { "enum": ["none", "fixed", "exponential"] },
        "initialDelaySeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "retryableReasonCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" } }
      }
    },
    "policyDecision": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/policyDecisionRef" },
    "labels": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/labels" },
    "signature": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/signature" }
  },
  "allOf": [
    { "if": { "type": "object", "properties": { "workloadClass": { "enum": ["container_service", "vm", "ai_service", "critical_service"] } }, "required": ["workloadClass"] }, "then": { "type": "object", "required": ["serviceObjectives"] } },
    { "if": { "type": "object", "properties": { "workloadClass": { "const": "vm" } }, "required": ["workloadClass"] }, "then": { "type": "object", "properties": { "runtime": { "type": "object", "properties": { "imageRef": { "type": "string", "pattern": "^vm://" } } } } }, "else": { "type": "object", "properties": { "runtime": { "type": "object", "properties": { "imageRef": { "type": "string", "pattern": "^oci://" } } } } } },
    { "if": { "type": "object", "properties": { "workloadClass": { "const": "hpc_mpi" } }, "required": ["workloadClass"] }, "then": { "type": "object", "properties": { "parallelism": { "type": "object", "properties": { "interTaskCommunication": { "const": "tightly_coupled" } } }, "networkRequirements": { "type": "object", "required": ["networkProfileId"] } } } },
    { "if": { "type": "object", "properties": { "criticality": { "enum": ["critical", "safety_records_authority"] } }, "required": ["criticality"] }, "then": { "type": "object", "required": ["serviceObjectives"], "properties": { "schedule": { "type": "object", "properties": { "preemptible": { "const": false } } } } } }
  ]
}
