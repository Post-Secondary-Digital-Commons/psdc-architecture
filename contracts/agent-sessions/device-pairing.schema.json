{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:agent-sessions:device-pairing:1",
  "title": "Agent Session Device Pairing Challenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "pairingId", "hostId", "challenge", "hostPublicKey", "createdAt", "expiresAt", "relayProfile"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "pairingId": { "type": "string", "format": "uuid" },
    "hostId": { "type": "string", "format": "uuid" },
    "challenge": { "type": "string", "contentEncoding": "base64" },
    "hostPublicKey": { "type": "string", "contentEncoding": "base64" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "relayProfile": { "type": "string", "minLength": 1, "maxLength": 200 },
    "requestedScopes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["session.read", "session.message", "session.interrupt", "permission.decide", "control.request"] }
    }
  }
}
