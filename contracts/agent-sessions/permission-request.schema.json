{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:agent-sessions:permission-request:1",
  "title": "Agent Permission Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "sessionId", "actionKind", "actionDigest", "summary", "risk", "requestedAt", "expiresAt", "allowedDecisions"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "requestId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "workspaceGrantId": { "type": "string", "format": "uuid" },
    "actionKind": { "enum": ["file_read", "file_write", "command", "network", "tool", "external_action"] },
    "actionDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "targets": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 1024 } },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "requestedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "allowedDecisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["allow_once", "deny"] }
    }
  }
}
